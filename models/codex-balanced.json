      "tier": "economy",
      "stages": [
        "implementation"
      ]
    },
    "unit-tests": {
      "tier": "economy",
      "stages": [
        "implementation"
      ]
    },
    "test-design": {
      "tier": "strong",
      "stages": [
        "implementation",
        "verification"
      ]
    },
    "test-execution": {
      "tier": "tool",
      "stages": [
