  "escalation": {
    "attempts_per_tier": 2,
    "max_failed_attempts": 8,
    "high_risk_floor": "strong",
    "critical_risk_floor": "frontier"
  },
  "update_policy": {
    "automatic_detection": true,
    "automatic_rebinding": false,
    "unavailable_model": "block",
    "unsupported_effort": "block",
    "silent_fallback": false
  }
